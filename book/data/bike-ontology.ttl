@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix def:     <https://example.org/bike/def/> .
@prefix id:      <https://example.org/bike/id/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .

# Which bicycles have a frame recorded as steel?
# The example.org IRIs are placeholders matching the course examples.

<https://example.org/bike> a owl:Ontology ;
    dcterms:title "Bike ontology"@en ;
    dcterms:description "An example ontology for describing bicycle inventories and comparing recorded frame materials, with bicycle types, components and colours."@en ;
    dcterms:creator "TDCC-NES Ontology Engineers"@en ;
    dcterms:publisher "TDCC-NES"@en ;
    dcterms:created "2026-10-19"^^xsd:date ;
    dcterms:modified "2026-11-07"^^xsd:date ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    owl:versionInfo "2.0.0" .

# Classes
# The initial model uses Vehicle, Bicycle, Component and Frame.
# Bicycle types and other components extend this initial scope.

def:Vehicle a owl:Class ;
    rdfs:label "vehicle"@en ;
    rdfs:comment "A physical object designed to transport people or goods."@en .

def:Bicycle a owl:Class ;
    rdfs:subClassOf def:Vehicle ;
    rdfs:label "bicycle"@en, "fiets"@nl ;
    rdfs:comment "A vehicle with two wheels, designed to be propelled by pedalling, with or without electric assistance."@en .

def:CargoBicycle a owl:Class ;
    rdfs:subClassOf def:Bicycle ;
    rdfs:label "cargo bicycle"@en ;
    rdfs:comment "A bicycle designed to carry goods or passengers in addition to the rider."@en .

def:Fatbike a owl:Class ;
    rdfs:subClassOf def:Bicycle ;
    rdfs:label "fatbike"@en ;
    rdfs:comment "A bicycle designed with unusually wide tyres."@en .

def:Component a owl:Class ;
    rdfs:label "component"@en ;
    rdfs:comment "A physical part of a bicycle."@en .

def:Frame a owl:Class ;
    rdfs:subClassOf def:Component ;
    rdfs:label "frame"@en ;
    rdfs:comment "A component forming the main supporting structure of a bicycle."@en .

def:Wheel a owl:Class ;
    rdfs:subClassOf def:Component ;
    rdfs:label "wheel"@en ;
    rdfs:comment "A circular component that rotates about an axle and supports a vehicle as it moves."@en .

def:CargoBox a owl:Class ;
    rdfs:subClassOf def:Component ;
    rdfs:label "cargo box"@en ;
    rdfs:comment "A box fitted to a vehicle to carry goods or passengers."@en .

# Properties
# Domain and range statements support inference; they are not validation rules.

def:hasComponent a owl:ObjectProperty ;
    rdfs:label "has component"@en ;
    rdfs:comment "Relates a bicycle to a physical part of that bicycle."@en ;
    rdfs:domain def:Bicycle ;
    rdfs:range def:Component .

# Colour and material can describe both vehicles and components.

def:hasColour a owl:DatatypeProperty ;
    rdfs:label "has colour"@en ;
    rdfs:comment "Records a colour of an object as text."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

def:hasMaterial a owl:DatatypeProperty ;
    rdfs:label "has material"@en ;
    rdfs:comment "Records a material an object is made of as text."@en ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

# Example individuals
# B001, B002 and B003 match the representative inventory records.
# B001 is the physical bicycle; F001, W001, W002 and CB001 are its parts.
# Colour and material are string values; labels and descriptions use @en.

id:B001 a owl:NamedIndividual, def:Bicycle, def:CargoBicycle ;
    rdfs:label "B001"@en ;
    rdfs:comment "A blue cargo bicycle with a steel frame, two wheels and a cargo box."@en ;
    def:hasComponent id:F001, id:W001, id:W002, id:CB001 ;
    def:hasColour "blue" .

id:F001 a owl:NamedIndividual, def:Frame ;
    rdfs:label "frame of B001"@en ;
    rdfs:comment "The steel frame belonging to B001."@en ;
    def:hasMaterial "steel" .

id:W001 a owl:NamedIndividual, def:Wheel ;
    rdfs:label "front wheel of B001"@en ;
    rdfs:comment "The front wheel belonging to B001."@en .

id:W002 a owl:NamedIndividual, def:Wheel ;
    rdfs:label "rear wheel of B001"@en ;
    rdfs:comment "The rear wheel belonging to B001."@en .

id:CB001 a owl:NamedIndividual, def:CargoBox ;
    rdfs:label "cargo box of B001"@en ;
    rdfs:comment "The box belonging to B001, designed to carry goods or children."@en .

id:B002 a owl:NamedIndividual, def:Bicycle ;
    rdfs:label "B002"@en ;
    rdfs:comment "A red bicycle with an aluminium frame (F002)."@en ;
    def:hasComponent id:F002 ;
    def:hasColour "red" .

id:F002 a owl:NamedIndividual, def:Frame ;
    rdfs:label "frame of B002"@en ;
    rdfs:comment "The aluminium frame belonging to B002."@en ;
    def:hasMaterial "aluminium" .

id:B003 a owl:NamedIndividual, def:Bicycle ;
    rdfs:label "B003"@en ;
    rdfs:comment "A black bicycle with frame F003."@en ;
    def:hasComponent id:F003 ;
    def:hasColour "black" .

# No material is recorded for F003.
id:F003 a owl:NamedIndividual, def:Frame ;
    rdfs:label "frame of B003"@en ;
    rdfs:comment "The frame belonging to B003."@en .

# Query the recorded facts without requiring a reasoner:
#
# PREFIX def: <https://example.org/bike/def/>
# PREFIX id: <https://example.org/bike/id/>
# PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
#
# SELECT DISTINCT ?bicycle WHERE {
#     ?bicycle a/rdfs:subClassOf* def:Bicycle ;
#              def:hasComponent ?frame .
#     ?frame a/rdfs:subClassOf* def:Frame ;
#            def:hasMaterial "steel" .
# }
#
# Expected result: id:B001.
