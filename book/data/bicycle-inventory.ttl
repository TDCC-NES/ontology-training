# Fictional inventory records for the ontology training.

@prefix def: <https://example.org/bike/def/> .
@prefix id: <https://example.org/bike/id/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

id:B001 a def:Bicycle ;
    def:hasComponent id:F001 ;
    def:hasColour "blue"@en .

id:F001 a def:Frame ;
    def:hasMaterial "steel"@en .

id:B002 a def:Bicycle ;
    def:hasComponent id:F002 ;
    def:hasColour "red"@en .

id:F002 a def:Frame ;
    def:hasMaterial "aluminium"@en .

id:B003 a def:Bicycle ;
    def:hasComponent id:F003 ;
    def:hasColour "black"@en .

# No material is recorded for F003.
id:F003 a def:Frame .

def:Bicycle rdfs:subClassOf def:Vehicle .
