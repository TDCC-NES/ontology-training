@prefix def: <https://example.org/bike/def/> .
@prefix id: <https://example.org/bike/id/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# A standalone example for the logical modelling chapter.
# Open this file on its own; it includes the required inventory facts.
# Example.org IRIs are placeholders matching the course examples.

<https://example.org/bike/reasoning> a owl:Ontology ;
    rdfs:label "Bicycle frame-material reasoning example"@en ;
    rdfs:comment "Classifies bicycles with a frame recorded as steel. Material names describe recorded wording, including its language tag."@en .

def:Vehicle a owl:Class .

def:Bicycle a owl:Class ;
    rdfs:subClassOf def:Vehicle .

def:Component a owl:Class .

def:Frame a owl:Class ;
    rdfs:subClassOf def:Component .

def:hasComponent a owl:ObjectProperty ;
    rdfs:domain owl:Thing ;
    rdfs:range def:Component .

# Language-tagged material values are used directly. The example leaves the
# range open, avoiding a dependency on a reasoner's RDF 1.1 datatype support.
def:hasMaterial a owl:DatatypeProperty ;
    rdfs:domain owl:Thing .

def:SteelFrame a owl:Class ;
    rdfs:label "frame recorded as steel"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            def:Frame
            [ a owl:Restriction ;
                owl:onProperty def:hasMaterial ;
                owl:hasValue "steel"@en ]
        ) ] .

def:BicycleWithSteelFrame a owl:Class ;
    rdfs:label "bicycle with a frame recorded as steel"@en ;
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            def:Bicycle
            [ a owl:Restriction ;
                owl:onProperty def:hasComponent ;
                owl:someValuesFrom def:SteelFrame ]
        ) ] .

id:B001 a owl:NamedIndividual, def:Bicycle ;
    def:hasComponent id:F001 .

id:F001 a owl:NamedIndividual, def:Frame ;
    def:hasMaterial "steel"@en .

id:B002 a owl:NamedIndividual, def:Bicycle ;
    def:hasComponent id:F002 .

id:F002 a owl:NamedIndividual, def:Frame ;
    def:hasMaterial "aluminium"@en .

id:B003 a owl:NamedIndividual, def:Bicycle ;
    def:hasComponent id:F003 .

# F003's material is unknown.
id:F003 a owl:NamedIndividual, def:Frame .

# Expected inferences: F001 is a SteelFrame; B001 is a BicycleWithSteelFrame;
# B001, B002 and B003 are Vehicles. Steel-frame membership and its negation
# are both unentailed for B002 and B003: additional material/component facts
# remain possible under the open-world assumption.
